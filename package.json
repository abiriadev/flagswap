{
	"name": "flagswap",
	"version": "1.0.0",
	"description": "Discord bot that swaps channel-name emojis to the maple flag at Canada Day",
	"main": "dist/index.js",
	"scripts": {
		"check": "tsc --noEmit",
		"start": "tsx --env-file-if-exists .env src/index.ts",
		"swap": "tsx --env-file-if-exists .env src/cli.ts swap",
		"restore": "tsx --env-file-if-exists .env src/cli.ts restore",
		"build": "tsc"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.4",
	"dependencies": {
		"croner": "^10.0.1",
		"discord.js": "^14.21.0",
		"tslog": "^4.10.2",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@types/node": "^24.0.8",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3"
	},
	"type": "module"
}
